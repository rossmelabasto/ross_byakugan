# Copia a .env y rellena. Nunca subas .env ni firebase-key.json.
PORT=8100
HOST=127.0.0.1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high: más razonamiento = respuestas más fiables pero más lentas
GROQ_REASONING=high
# Ruta al JSON de la cuenta de servicio de Firebase (Firestore)
FIREBASE_KEY_PATH=./firebase-key.json
# Contraseña del panel admin y secreto para firmar la cookie de sesión (largo y aleatorio)
ADMIN_PASSWORD=
SESSION_SECRET=
# Versión vigente de los términos (si cambia, los dispositivos deben volver a aceptar)
TERMS_VERSION=1
# Avisos opcionales por Telegram (vacío = desactivado)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
